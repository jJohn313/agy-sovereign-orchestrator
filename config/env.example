# AGY Environment Configuration Template
# Copy this file to ~/.config/agy/env and configure credentials.

# TypeSafe Jev API Key (optional; fallback to local sovereign NLI engine if unset)
TYPESAFE_API_KEY=""

# Custom Jev API URL (defaults to https://thejevai.com/v1/systemone)
# TYPESAFE_API_URL="https://thejevai.com/v1/systemone"

# Local NLI Backbone Model (HuggingFace identifier)
# Default: cross-encoder/nli-deberta-v3-large
# Fallback: dleemiller/finecat-nli-l
NLI_MODEL_NAME="cross-encoder/nli-deberta-v3-large"

# Mem0 User Namespace (default: john)
MEM0_USER="john"
